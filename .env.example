# ==============================================================================
# KanzleiFlow — Environment Configuration (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env.local` for local development.
# - DO NOT commit real secrets or credentials to version control.
# - NEVER expose database connection strings or service-role keys with NEXT_PUBLIC_
# ==============================================================================

# Supabase Project Database Connection
# ------------------------------------------------------------------------------
# 1. DATABASE_URL:
#    Used by the application runtime (Prisma Client via pg pool).
#    If using Supabase Connection Pooler (Transaction Mode, port 6543):
#    Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#    Or if using Session Pooler / Direct port 5432:
#    Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL:
#    Used by Prisma CLI for migrations, introspection, and schema management.
#    Must connect directly to PostgreSQL on port 5432 (or Session Pooler on port 5432)
#    because transaction poolers (port 6543) do not support advisory locks and prepared statements.
#    Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Public API (Optional for Milestone 1, needed for Supabase Auth in later milestones)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Application Tenant Configuration (Default demo context for Milestone 1)
# ------------------------------------------------------------------------------
APP_ENV="development"
DEFAULT_ORG_SLUG="notariat-weiss-partner"

# Next.js & Session Security
# ------------------------------------------------------------------------------
# SESSION_SECRET="your-cryptographic-32-character-secret"

# LLM Provider Configuration (Milestone 2 AI Extraction Workflow)
# ------------------------------------------------------------------------------
# Choose one of: 'mock' (default offline demo), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER="mock"

# OpenAI Configuration (optional if LLM_PROVIDER="openai")
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Anthropic Configuration (optional if LLM_PROVIDER="anthropic")
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Google Gemini Configuration (optional if LLM_PROVIDER="gemini")
# GEMINI_API_KEY="AIzaSy..."
# GEMINI_MODEL="gemini-3.8-flash"



# Public synthetic portfolio demo (enabled by default; false disables both guests)
ENABLE_DEMO_LOGIN=true
